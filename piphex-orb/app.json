{
  "expo": {
    "name": "Piphex Orb",
    "slug": "piphex-orb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/piphex-orb-icon.png",
    "scheme": "piphexorb",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/piphex-orb-icon.png",
      "bundleIdentifier": "com.gizmolifemedia.piphexorb",
      "supportsTablet": false,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070506",
          "image": "./assets/images/piphex-orb-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Piphex Orb to hear you when you tap the orb."
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13f467dc-9b84-45d8-b9b8-83929b51b2b8"
      }
    },
    "owner": "gizmolifes-team",
    "updates": {
      "url": "https://u.expo.dev/13f467dc-9b84-45d8-b9b8-83929b51b2b8"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
